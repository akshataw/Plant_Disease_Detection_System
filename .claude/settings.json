{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/review_on_change.py\"",
            "timeout": 15,
            "statusMessage": "Checking whether the change needs a code review…"
          }
        ]
      }
    ]
  }
}
