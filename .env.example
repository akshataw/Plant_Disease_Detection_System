# Copy to .env and fill in values: cp .env.example .env

# --- Database ---
POSTGRES_USER=plantuser
POSTGRES_PASSWORD=change-me
POSTGRES_DB=plantdb

# --- Backend ---
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
MODEL_TYPE=keras
MODEL_PATH=/app/models/plant_disease_v1.keras
CLASS_NAMES_PATH=/app/models/class_names.json
MAX_UPLOAD_MB=10
GUNICORN_WORKERS=2

# --- ngrok (only needed with: docker compose --profile public up) ---
NGROK_AUTHTOKEN=
# Optional static domain from the ngrok dashboard, e.g. my-app.ngrok-free.app
NGROK_DOMAIN=

# --- Host port for nginx (bound to 127.0.0.1; public access goes through ngrok) ---
HTTP_PORT=8080
